{
  "name": "tabcast-browser",
  "version": "0.2.2",
  "private": false,
  "description": "Maka gaming streaming service — the ultimate resource-light streaming software for gamers and creators (Electron studio + local WHIP/RTMP relay).",
  "author": "n0social",
  "license": "MIT",
  "homepage": "https://github.com/n0social/Maka",
  "repository": {
    "type": "git",
    "url": "https://github.com/n0social/Maka.git"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fetch:relay": "node scripts/fetch-relay.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:offline": "node scripts/verify.mjs --offline",
    "export:marketplace": "node scripts/export-marketplace.mjs",
    "marketing": "python scripts/generate-marketing.py",
    "dist": "npm run typecheck && npm run build && node scripts/verify.mjs --offline && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win dir",
    "dist:signed": "node scripts/dist-signed.mjs",
    "dist:ci": "npm run typecheck && npm run build && node scripts/verify.mjs --offline && electron-builder --win nsis --publish always",
    "sign:relay": "node scripts/sign-windows.mjs vendor/relay/TabcastRelay.exe",
    "sign:verify": "node scripts/sign-windows.mjs --verify --all",
    "release:manifest": "node scripts/update-browser-manifest.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/qrcode": "^1.5.6",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=22.5"
  },
  "build": {
    "appId": "work.skydav.tabcast.browser",
    "productName": "Maka",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/relay",
        "to": "relay",
        "filter": [
          "TabcastRelay.exe",
          "relay-manifest.json"
        ]
      },
      {
        "from": "resources/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/icon.ico",
      "executableName": "Maka",
      "artifactName": "Maka-Setup-${version}.${ext}",
      "signAndEditExecutable": true,
      "forceCodeSigning": false,
      "signtoolOptions": {
        "timeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Maka"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "n0social",
        "repo": "tabcast-browser",
        "releaseType": "release"
      }
    ]
  }
}
