{
  "name": "maka",
  "version": "0.2.8",
  "private": false,
  "description": "Maka v0.2.8 — lightweight video game streaming platform for Windows. Cloud streaming for streamers on GeForce NOW, Xbox Cloud Gaming, Shadow PC, and Cloud Moon; PVP and competitive live streams to Twitch & YouTube (WHIP + MAKArelay).",
  "keywords": [
    "maka",
    "game-streaming",
    "cloud-streaming",
    "cloud-gaming-stream",
    "cloud-streaming-for-streamers",
    "lightweight-streaming",
    "lightweight-video-game-streaming-platform",
    "pvp-streaming",
    "competitive-gaming-stream",
    "geforce-now-streaming",
    "nvidia-geforce-now",
    "xbox-cloud-gaming",
    "xcloud-streaming",
    "shadow-pc",
    "shadow-cloud-gaming",
    "cloud-moon",
    "cloud-moon-gaming",
    "obs-alternative",
    "twitch",
    "youtube",
    "rtmp",
    "whip",
    "maka-relay",
    "windows-streaming-software",
    "electron"
  ],
  "author": "n0social",
  "license": "MIT",
  "homepage": "https://makalive.stream",
  "repository": {
    "type": "git",
    "url": "https://github.com/n0social/maka-streaming-software.git"
  },
  "bugs": {
    "url": "https://github.com/n0social/maka-streaming-software/issues"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fetch:relay": "node scripts/fetch-relay.mjs",
    "fetch:release-backup": "node scripts/fetch-release-backup.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:offline": "node scripts/verify.mjs --offline",
    "verify:addons": "node scripts/verify-addons.mjs --write-report",
    "export:marketplace": "node scripts/export-marketplace.mjs",
    "marketing": "python scripts/generate-marketing.py",
    "dist": "npm run typecheck && npm run build && node scripts/verify.mjs --offline && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win dir",
    "dist:signed": "node scripts/dist-signed.mjs",
    "dist:ci": "npm run typecheck && npm run build && node scripts/verify.mjs --offline && electron-builder --win nsis --publish always",
    "sign:relay": "node scripts/sign-windows.mjs vendor/relay/MAKArelay.exe",
    "sign:verify": "node scripts/sign-windows.mjs --verify --all",
    "release:manifest": "node scripts/update-browser-manifest.mjs",
    "web:relay": "node scripts/web-relay-dev.mjs",
    "dev:web-studio": "node scripts/web-studio-dev.mjs --with-relay",
    "dev:web-studio:site": "node scripts/web-studio-dev.mjs",
    "test:web-relay": "node scripts/web-relay-smoke.test.mjs --spawn",
    "test:studio-wiring": "node --experimental-strip-types scripts/studio-wiring.test.ts",
    "test:encode-adapt": "node --experimental-strip-types scripts/encode-adapt.test.mjs",
    "test:encode-backpressure": "node --experimental-strip-types scripts/encode-backpressure.test.mjs",
    "test:relay-encode-patch": "node --experimental-strip-types scripts/relay-encode-patch.test.mjs",
    "test:platform-viewers": "node --experimental-strip-types scripts/platform-viewers.test.mjs",
    "test:relay-live-stats": "node scripts/relay-live-stats.test.mjs",
    "test:qos-score": "node --experimental-strip-types scripts/qos-score.test.mjs",
    "test:qos-log": "node --experimental-strip-types scripts/qos-log.test.mjs",
    "test:retired-addons": "node --experimental-strip-types scripts/retired-addons.test.mjs",
    "test:game-audio-source": "node --experimental-strip-types scripts/game-audio-source.test.mjs",
    "test:capture-health": "node --experimental-strip-types scripts/capture-health.test.mjs",
    "test:capture-fallback": "node --experimental-strip-types scripts/capture-fallback.test.mjs",
    "test:live-retry": "node scripts/live-retry.test.mjs",
    "verify:site-seo": "node scripts/verify-site-seo.mjs",
    "test:studio-ui": "node scripts/studio-wiring-ui.mjs",
    "dev:studio": "electron-vite dev"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/qrcode": "^1.5.6",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "loopback-capture": "^4.0.0",
    "qrcode": "^1.5.4",
    "werift": "^0.25.2"
  },
  "engines": {
    "node": ">=22.5"
  },
  "build": {
    "appId": "work.skydav.tabcast.browser",
    "productName": "Maka",
    "extraMetadata": {
      "description": "Lightweight cloud game streaming for Windows — GeForce NOW, Xbox Cloud Gaming, Shadow PC, Cloud Moon, PVP streamers."
    },
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/loopback-capture/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "asarUnpack": [
      "node_modules/loopback-capture/**/*.node"
    ],
    "extraResources": [
      {
        "from": "vendor/relay",
        "to": "relay",
        "filter": [
          "MAKArelay.exe",
          "relay-manifest.json"
        ]
      },
      {
        "from": "resources/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/icon.ico",
      "executableName": "Maka",
      "artifactName": "Maka-Setup-${version}.${ext}",
      "signAndEditExecutable": true,
      "forceCodeSigning": false,
      "signtoolOptions": {
        "timeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Maka"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "n0social",
        "repo": "maka-streaming-software",
        "releaseType": "release"
      }
    ]
  }
}
