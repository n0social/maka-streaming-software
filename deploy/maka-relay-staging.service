[Unit]
Description=MAKA staging open relay (relay/src/index.mjs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/maka/maka-streaming-software
Environment=NODE_ENV=production
Environment=RELAY_HOST=127.0.0.1
Environment=RELAY_PORT=38473
ExecStart=/usr/bin/node relay/src/index.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
